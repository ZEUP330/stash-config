#SUBSCRIBED https://raw.githubusercontent.com/ZEUP330/stash-config/main/Stash-Complete.stoverride
# 不含节点或订阅凭据；与服务商订阅配合使用。
# 检测设置：地区测速10分钟，故障检测5分钟，服务卡片6小时；保留lazy模式。
# 关闭旧分流与旧检测覆写；选择规则模式，并打开脚本以运行面板。
# 各地区组选好节点，空组可能直连。未实机验证；不修改 DNS。
name: 常用外网与地区分流（省电版）
desc: ChatGPT、Claude、Google及通用外网新加坡优先；网络故障美国备用。地区拒绝须手动选择。Muse默认美国；美日台常用网站独立分组；未匹配直连。含HTTP检测面板；非解锁检测。
mode: rule
proxy-groups:
- name: 自动-新加坡
  type: url-test
  include-all: true
  filter: 新加坡|🇸🇬|Singapore
  interval: 600
  tolerance: 100
  lazy: true
- name: 自动-美国
  type: url-test
  include-all: true
  filter: 美国|🇺🇸|United States
  interval: 600
  tolerance: 100
  lazy: true
- name: 自动-日本
  type: url-test
  include-all: true
  filter: 日本|🇯🇵|Japan
  interval: 600
  tolerance: 100
  lazy: true
- name: 自动-台湾
  type: url-test
  include-all: true
  filter: 台湾|台灣|🇹🇼|Taiwan
  interval: 600
  tolerance: 100
  lazy: true
- name: 地区-新加坡
  type: select
  include-all: true
  filter: 新加坡|🇸🇬|Singapore
  proxies:
  - 自动-新加坡
  interval: 600
  lazy: true
- name: 地区-美国
  type: select
  include-all: true
  filter: 美国|🇺🇸|United States
  proxies:
  - 自动-美国
  interval: 600
  lazy: true
- name: 新加坡优先-网络故障切换
  type: fallback
  proxies:
  - 地区-新加坡
  - 地区-美国
  interval: 300
  lazy: true
- name: 服务-ChatGPT
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/chatgpt.png
- name: 服务-Claude
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/claude-ai.png
- name: 服务-Google
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/google.png
- name: 服务-YouTube
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/youtube.png
- name: 服务-GitHub
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/github-light.png
- name: 服务-社交与通信
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
- name: 服务-Netflix
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/netflix.png
- name: 服务-Spotify
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/spotify.png
- name: 服务-其他外网
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
- name: 服务-Migoo
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
- name: 服务-Muse
  type: select
  proxies:
  - 地区-美国
  - 地区-新加坡
- name: 未匹配流量
  type: select
  proxies:
  - DIRECT
  - 服务-其他外网
- name: 地区-日本
  type: select
  include-all: true
  filter: 日本|🇯🇵|Japan
  proxies:
  - 自动-日本
  interval: 600
  lazy: true
- name: 地区-台湾
  type: select
  include-all: true
  filter: 台湾|台灣|🇹🇼|Taiwan
  proxies:
  - 自动-台湾
  interval: 600
  lazy: true
- name: 美国网站
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
- name: 日本网站
  type: select
  proxies:
  - 地区-日本
  - 新加坡优先-网络故障切换
- name: 台湾网站
  type: select
  proxies:
  - 地区-台湾
  - 新加坡优先-网络故障切换
- name: 开发服务
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/docker.png
- name: 协作与云盘
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/notion-light.png
- name: 其他AI
  type: select
  proxies:
  - 新加坡优先-网络故障切换
  - 地区-美国
  - 地区-新加坡
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/perplexity.png
- name: 美国限定服务
  type: select
  proxies:
  - 地区-美国
  - 新加坡优先-网络故障切换
rule-providers:
  Custom-OpenAI:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/openai.yaml
    interval: 86400
  Custom-Claude:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/anthropic.yaml
    interval: 86400
  Custom-Google:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/google.yaml
    interval: 86400
  Custom-Proxy:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/proxy.txt
    interval: 86400
  Custom-Direct:
    behavior: domain
    format: yaml
    url: https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt
    interval: 86400
  Full-GitHub:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/GitHub/GitHub.yaml
    interval: 86400
  Full-Docker:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Docker/Docker.yaml
    interval: 86400
  Full-Abema:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/AbemaTV/AbemaTV.yaml
    interval: 86400
  Full-Bahamut:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Bahamut/Bahamut.yaml
    interval: 86400
  Full-YouTube:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/YouTube/YouTube.yaml
    interval: 86400
  Full-Perplexity:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/classical/perplexity.yaml
    interval: 86400

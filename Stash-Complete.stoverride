tiles:
- name: Probe-ChatGPT
  title: ChatGPT 地区接口
  content: 等待检测；更新后请刷新
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/chatgpt.png
  collapsed: true
  interval: 21600
  url: https://chatgpt.com
  argument: '{"title": "ChatGPT 地区接口", "url": "https://api.openai.com/compliance/cookie_requirements", "openUrl": "https://chatgpt.com",
    "proxy": "服务-ChatGPT", "kind": "openai-region", "icon": "https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/chatgpt.png"}'
- name: Probe-ChatGPT-App
  title: ChatGPT iOS入口
  content: 等待检测；更新后请刷新
  icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/chatgpt.png
  collapsed: true
  interval: 21600
  url: https://chatgpt.com
  argument: '{"title": "ChatGPT iOS入口", "url": "https://ios.chat.openai.com", "openUrl": "https://chatgpt.com", "proxy": "服务-ChatGPT",
    "kind": "openai-ios", "icon": "https://raw.githubusercontent.com/homarr-labs/dashboard-icons/d3b9234dd56f3af5862f06741f0dce101193b3df/png/chatgpt.png"}'
- name: Probe-Claude
